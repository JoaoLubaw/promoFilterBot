#DotNet environment configuration
DOTNET_ENVIRONMENT=Production

#Image published by the GitHub Actions. The deploy (deploy.yml) rewrites this line with the image it deployed
PROMOFILTERBOT_IMAGE=ghcr.io/joaolubaw/promofilterbot:latest

#Database (the container is not exposed outside the compose network)
POSTGRES_USER=promofilterbot
POSTGRES_PASSWORD=
POSTGRES_DB=promofilterbot

#Official bot, created inside Telegram: chat with @BotFather, /newbot, and paste the token it answers with
BOT_TOKEN=

#Chat of the admin (send /start to @userinfobot to find yours): /admin, the only one who registers channels, gets the alerts of the reader
ADMIN_CHAT_ID=
TIME_ZONE=America/Sao_Paulo

#Reader account: your own Telegram account, used only to read the registered channels. api_id and api_hash from my.telegram.org (API development tools)
READER_ENABLED=true
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE_NUMBER=

#Backup (scripts/backup.sh): days kept, and an optional rclone remote for the copy out of the VM (e.g. gdrive:promofilterbot)
BACKUP_KEEP_DAYS=7
RCLONE_REMOTE=
