{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.Hosting.Lifetime": "Information",
            "Microsoft.EntityFrameworkCore": "Warning"
        }
    },
    "ConnectionStrings": {
        "PromoFilterBotPostgres": ""
    },
    "Database": {
        "ApplyMigrationsOnStartup": true
    },
    "General": {
        "AdminChatId": 0,
        "TimeZone": "America/Sao_Paulo"
    },
    "Bot": {
        "Token": "",
        "DropPendingUpdates": false,
        "GlobalMessagesPerSecond": 30,
        "PerChatIntervalMilliseconds": 1000,
        "NotifierConcurrency": 4,
        "MaxSendAttempts": 3
    },
    "Reader": {
        "Enabled": true,
        "ApiId": 0,
        "ApiHash": "",
        "PhoneNumber": "",
        "SessionPath": "session/wtelegram.session",
        "UpdatesStatePath": "session/updates.state",
        "JoinIntervalMinutes": 15,
        "JoinJitterMinutes": 10,
        "MaxJoinsPerDay": 10,
        "ResolveIntervalSeconds": 60,
        "MuteJoinedChannels": true,
        "ArchiveJoinedChannels": true,
        "MaxChannels": 500,
        "FloodRetryThresholdSeconds": 60,
        "LongFloodWaitAlertSeconds": 300,
        "ReconnectDelaySeconds": 30,
        "ActiveChannelsRefreshSeconds": 120,
        "StateSaveIntervalSeconds": 60
    },
    "Limits": {
        "MaxActiveAlertsPerUser": 10,
        "MaxAlertsPerUser": 30,
        "MaxAlertTextLength": 200,
        "MaxPriceLimit": 1000000,
        "MessageRetentionDays": 30,
        "ConversationTimeoutHours": 24
    },
    "Matching": {
        "NotifyWhenPriceUnknown": true,
        "ResolveShortLinks": true,
        "ShortLinkHosts": [],
        "ShortLinkTimeoutSeconds": 3,
        "AlertIndexRefreshMinutes": 10,
        "OfferQueueCapacity": 1000
    },
    "Monitoring": {
        "CheckIntervalMinutes": 5,
        "DisconnectedAlertMinutes": 10,
        "SilenceAlertHours": 6,
        "CleanupIntervalHours": 24
    },
    "Serilog": {
        "Using": ["Serilog.Sinks.Console", "Serilog.Sinks.File"],
        "MinimumLevel": {
            "Default": "Information",
            "Override": {
                "Microsoft": "Warning",
                "Microsoft.Hosting.Lifetime": "Information",
                "System.Net.Http": "Warning"
            }
        },
        "WriteTo": [
            {
                "Name": "Console"
            },
            {
                "Name": "File",
                "Args": {
                    "path": "logs/log-.txt",
                    "rollingInterval": "Day",
                    "retainedFileCountLimit": 14,
                    "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {SourceContext} {Message:lj} {Scope}{NewLine}{Exception}"
                }
            }
        ],
        "Enrich": ["FromLogContext"]
    }
}
